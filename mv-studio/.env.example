# Optional server-only overrides; never put real keys in public/.
PORT=8792
FFMPEG_BIN=
FFPROBE_BIN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Supply only your own server-side credentials; other project env files are not read.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
MV_VIDEO_REGION=cn-beijing
MV_VIDEO_MODEL=wanx2.1-t2v-turbo
MV_VIDEO_BUDGET_CNY=20
# Set to 1 for strictly offline model tests.
MV_DISABLE_MODELS=1

# Optional local TTF/OTF/TTC file for subtitles; otherwise use a compatible system font.
MV_SUBTITLE_FONT=

# Optional image understanding model; must be available in the selected workspace.
DASHSCOPE_VISION_MODEL=qwen3.5-flash

# Optional local ASR. No environment or model download is automatic.
MV_ASR_PYTHON=
MV_ASR_MODEL=
# Optional local image tools.
MV_VISION_PYTHON=
MV_VISION_MODELS=
MV_VISION_PACKAGES=
