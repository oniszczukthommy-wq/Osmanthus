# Server-side settings only. Copy to .env, never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
YINCHAO_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
MUSIC_EDITOR_PORT=8603
MUSIC_MV_PORT=8792
# Switch to 0 only when ready to submit paid MV generation.
MV_DISABLE_MODELS=1
MV_IMAGE_BUDGET_CNY=4
MV_VIDEO_BUDGET_CNY=20
# Counts of new provider attempts, NOT CNY. Failed/uncertain calls still count.
# Daily limits reset at 00:00 UTC; lifetime totals survive restarts. 0 blocks calls.
MUSIC_TEXT_DAILY_LIMIT=60
MUSIC_SONG_DAILY_LIMIT=6
MUSIC_ARTWORK_DAILY_LIMIT=6
MUSIC_PAID_MAX_CONCURRENT=2
MUSIC_DRAFT_MAX_WORKERS=2
MUSIC_PAID_RATE_PER_MINUTE=12
MUSIC_PAID_TOTAL_LIMIT=300
# Optional ledger location: omit this variable to use the default, do not set blank.
# MUSIC_PAID_USAGE_DB=C:/Osmanthus-local/paid-usage.sqlite3
# MV text calls have their own persistent ledger, separate from music and CNY budgets.
MV_TEXT_DAILY_LIMIT=40
MV_TEXT_TOTAL_LIMIT=300
MV_TEXT_RATE_PER_MINUTE=8
MV_TEXT_MAX_CONCURRENT=2
# Optional absolute paths. Leave blank to use PATH.
FFMPEG_BIN=
FFPROBE_BIN=
MV_SUBTITLE_FONT=

# Rebuildable audio preview cache per project; current/active media stays protected.
MUSIC_PREVIEW_CACHE_MAX_BYTES=536870912
# Async MV media subprocess pool; excess uploads return a retryable busy error.
MV_MEDIA_CONCURRENCY=2
MV_MEDIA_QUEUE_LIMIT=8
