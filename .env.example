# Server-side settings only. Copy to .env, never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
YINCHAO_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
MUSIC_EDITOR_PORT=8603
MUSIC_MV_PORT=8792
