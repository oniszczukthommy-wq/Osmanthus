MV_DISABLE_MODELS=1
MV_IMAGE_BUDGET_CNY=4
MV_VIDEO_BUDGET_CNY=20
# Optional absolute paths. Leave blank to use PATH.
FFMPEG_BIN=
FFPROBE_BIN=
MV_SUBTITLE_FONT=
